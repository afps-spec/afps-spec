{
  "$schema": "https://schemas.afps.dev/v0/integration.schema.json",
  "name": "@example/fetch-json-authenticated",
  "version": "1.0.0",
  "type": "integration",
  "schema_version": "0.3",
  "display_name": "Fetch JSON (authenticated)",
  "description": "Local MCP server declared inline and shipped in the archive; the integration applies an API key to the server process through environment-variable delivery.",
  "keywords": [
    "http",
    "api"
  ],
  "source": {
    "kind": "local",
    "server": {
      "type": "node",
      "entry_point": "server/index.js",
      "mcp_config": {
        "command": "node",
        "args": [
          "${__dirname}/server/index.js"
        ]
      },
      "tools": [
        {
          "name": "fetch_json",
          "description": "Fetch JSON from a URL and return the parsed response."
        }
      ]
    }
  },
  "auths": {
    "api_key": {
      "type": "api_key",
      "credentials": {
        "schema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "description": "Upstream API key"
            }
          },
          "required": [
            "api_key"
          ]
        }
      },
      "delivery": {
        "env": {
          "FETCH_JSON_API_KEY": {
            "value": "{$credential.api_key}",
            "sensitive": true
          }
        }
      }
    }
  },
  "default_tools": [
    "fetch_json"
  ]
}
